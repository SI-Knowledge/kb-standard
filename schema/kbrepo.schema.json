{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://si-knowledge/kb-standard/schema/kbrepo.schema.json",
  "title": "KB repo metadata (.kbrepo.yml)",
  "type": "object",
  "required": ["project", "primary_manager", "managers", "max_sensitivity", "tier"],
  "properties": {
    "project": { "type": "string", "minLength": 1 },
    "primary_manager": { "type": "string", "pattern": "^@[A-Za-z0-9-]+$" },
    "managers": {
      "type": "array",
      "items": { "type": "string", "pattern": "^@[A-Za-z0-9-]+$" },
      "minItems": 1,
      "description": "recommended bus factor >= 2 managers per repo; 1 is allowed for solo pilot repos but should be raised as soon as a second manager is onboarded"
    },
    "max_sensitivity": {
      "type": "string",
      "enum": ["public", "internal", "confidential", "restricted"]
    },
    "tier": { "type": "integer", "minimum": 1 },
    "description": { "type": "string" }
  }
}
